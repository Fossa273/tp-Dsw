generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Client {
  id        Int     @id @default(autoincrement())
  firstName String?
  lastName  String?
  dni       String?
  email     String? @unique
  phone     String?
  active    Int     @default(1)
  password  String?
  logged    Int     @default(0)

  bookings Booking[]

  @@map("clients")
}

model Driver {
  id        Int     @id @default(autoincrement())
  dni       String? @unique
  firstName String?
  lastName  String?
  phone     String?
  active    Int     @default(1)

  trips Trip[]

  @@map("drivers")
}

model Vehicle {
  id          Int     @id @default(autoincrement())
  maxCapacity Int
  categoryId  Int     @default(1)
  category    String  @default("Combi")
  categoryRelation VehicleCategory @relation(fields: [categoryId], references: [idCategoria])
  hasBathroom Boolean @default(false)
  maintenance Boolean @default(false)

  trips Trip[]

  @@map("vehicles")
}

model VehicleCategory {
  idCategoria     Int      @id @default(autoincrement()) @map("idcategoria")
  nombreCategoria String   @map("nombrecategoria")
  precioBase      Float    @map("preciobase")
  vehicles        Vehicle[]
  priceHistory    VehicleCategoryPrice[]

  @@map("vehicle_categories")
}

model VehicleCategoryPrice {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  precioBase Float    @map("preciobase")
  createdAt  DateTime @default(now()) @map("created_at")
  category   VehicleCategory @relation(fields: [categoryId], references: [idCategoria])

  @@index([categoryId, createdAt])
  @@map("vehicle_category_price_history")
}

model Locality {
  id                 Int       @id @default(autoincrement())
  name               String?
  provinceId         Int?
  province           Province? @relation(fields: [provinceId], references: [id])
  originJourneys     Journey[] @relation("JourneyOrigin")
  destinationJourneys Journey[] @relation("JourneyDestination")

  @@map("localities")
}

model Journey {
  id              Int      @id @default(autoincrement())
  originId        Int
  destinationId   Int
  distanceKm      Int      @default(0)
  durationMinutes Int      @default(0)
  active          Int      @default(1)

  origin      Locality @relation("JourneyOrigin", fields: [originId], references: [id])
  destination Locality @relation("JourneyDestination", fields: [destinationId], references: [id])

  trips Trip[]

  @@unique([originId, destinationId])
  @@map("journeys")
}

model Province {
  id          Int          @id @default(autoincrement())
  name        String?
  abbreviation String?     @map("abbreviation")
  localities  Locality[]

  @@map("provinces")
}

model Trip {
  id            Int     @id @default(autoincrement())
  journeyId     Int
  driverId      Int
  vehicleId     Int
  dayOfWeek     Int
  departureTime String
  arrivalTime   String?
  scheduleType  String  @default("weekly")
  departureDate DateTime?
  arrivalDate   DateTime?
  arrivesNextDay Boolean @default(false)
  active        Int     @default(1)

  journey        Journey        @relation(fields: [journeyId], references: [id])
  driver         Driver         @relation(fields: [driverId], references: [id])
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  bookings       Booking[]

  @@map("trips")
}

model Booking {
  id       Int    @id @default(autoincrement())
  clientId Int
  tripId   Int
  numSeats Int    @default(1)
  state    String @default("pending")
  price    Float  @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])
  trip   Trip   @relation(fields: [tripId], references: [id])

  @@map("bookings")
}
